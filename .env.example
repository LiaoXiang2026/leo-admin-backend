# NestJS Backend 生产环境配置
# 请复制此文件为 .env 并修改以下配置

# 服务端口
PORT=3000

# JWT 配置（生产环境请务必更换为强密钥）
JWT_SECRET=your-production-jwt-secret-key-min-32-characters-long
JWT_REFRESH_SECRET=your-production-refresh-secret-key-change-immediately
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# 数据库配置（Neon PostgreSQL 或其他 PostgreSQL）
# 格式: postgresql://用户名:密码@主机名:端口/数据库名?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your-password@your-neon-host.neon.tech/neondb?sslmode=require

# 可选: 日志级别
# LOG_LEVEL=info
