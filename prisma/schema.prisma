// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  realName  String   @map("real_name")
  avatar    String?
  desc      String?
  homePath  String   @default("/dashboard") @map("home_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles    Role[]
  // 用户自定义的权限码（直接关联）
  permissions Permission[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  roles Role[]
  users User[]

  @@map("permissions")
}

model OperateLog {
  id          Int      @id @default(autoincrement())
  operator    String
  module      String
  action      String
  description String?
  method      String
  url         String
  params      String?
  duration    Int?
  ip          String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([module])
  @@index([action])
  @@index([operator])
  @@index([createdAt])
  @@map("operate_logs")
}

model DictType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dict_types")
}

model DictData {
  id        Int      @id @default(autoincrement())
  typeCode  String   @map("type_code")
  label     String
  value     String
  sort      Int      @default(0)
  status    Int      @default(1)
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([typeCode])
  @@map("dict_data")
}
