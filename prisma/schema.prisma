// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  realName  String   @map("real_name")
  avatar    String?
  desc      String?
  homePath  String   @default("/dashboard") @map("home_path")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roles    Role[]
  menus    Menu[]
  // 用户自定义的权限码（直接关联）
  permissions Permission[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  roles Role[]
  users User[]

  @@map("permissions")
}

model Menu {
  id        String   @id @default(uuid())
  name      String
  path      String
  component String
  parentId  String?  @map("parent_id")
  order     Int      @default(0)

  // Meta 字段平铺
  title           String?
  icon            String?
  hideInMenu      Boolean @default(false) @map("hide_in_menu")
  hideInTab       Boolean @default(false) @map("hide_in_tab")
  keepAlive       Boolean @default(false) @map("keep_alive")
  affixTab        Boolean @default(false) @map("affix_tab")
  badge           String?
  badgeType       String? @map("badge_type")
  activeIcon      String? @map("active_icon")
  activePath      String? @map("active_path")
  hideChildrenInMenu Boolean @default(false) @map("hide_children_in_menu")
  hideInBreadcrumb   Boolean @default(false) @map("hide_in_breadcrumb")
  iframeSrc          String? @map("iframe_src")
  link               String?
  openInNewWindow    Boolean @default(false) @map("open_in_new_window")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 自关联
  parent   Menu?  @relation("MenuChildren", fields: [parentId], references: [id])
  children Menu[] @relation("MenuChildren")

  // 关联用户（哪些用户可见此菜单）
  users User[]

  @@map("menus")
}

model DictType {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dict_types")
}

model DictData {
  id        Int      @id @default(autoincrement())
  typeCode  String   @map("type_code")
  label     String
  value     String
  sort      Int      @default(0)
  status    Int      @default(1)
  remark    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([typeCode])
  @@map("dict_data")
}
